# =====================================================
# Конфигурация Apache для Яркий Парк Backend API
# Защита от DOS/DDOS и базовые правила безопасности
# =====================================================

# Направить все запросы через index.php
Options -MultiViews
RewriteEngine On
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [QSA,L]

# -------------------------------------------------------
# ЗАЩИТА ОТ DOS/DDOS — Ограничения на уровне Apache
# -------------------------------------------------------

# Ограничить максимальный размер тела запроса (10 МБ)
LimitRequestBody 10485760

# -------------------------------------------------------
# БЛОКИРОВКА ПОДОЗРИТЕЛЬНЫХ USER-AGENT
# (сканеры, боты, инструменты атак)
# -------------------------------------------------------
RewriteCond %{HTTP_USER_AGENT} (libwww-perl|wget|python|nikto|curl|scan|java|winhttp|clshttp|loader|netsparker|sqlmap|nmap|masscan|zgrab) [NC]
RewriteRule .* - [F,L]

# Блокировка запросов без User-Agent
RewriteCond %{HTTP_USER_AGENT} ^$
RewriteRule .* - [F,L]

# -------------------------------------------------------
# БЛОКИРОВКА ВРЕДОНОСНЫХ ЗАПРОСОВ
# -------------------------------------------------------

# Блокировка попыток SQL-инъекций в URL
RewriteCond %{QUERY_STRING} (union|select|insert|update|delete|drop|truncate|alter|exec|execute|script|javascript|vbscript|onload|onerror) [NC]
RewriteRule .* - [F,L]

# Блокировка попыток обхода директорий
RewriteCond %{REQUEST_URI} (\.\./|\.\.\\) [NC]
RewriteRule .* - [F,L]

# Блокировка попыток включения удалённых файлов (RFI)
RewriteCond %{QUERY_STRING} (http|https|ftp):// [NC]
RewriteRule .* - [F,L]

# -------------------------------------------------------
# ЗАГОЛОВКИ БЕЗОПАСНОСТИ
# -------------------------------------------------------
<IfModule mod_headers.c>
    # Запрет встраивания в iframe (Clickjacking)
    Header always set X-Frame-Options "DENY"

    # Запрет определения MIME-типа браузером
    Header always set X-Content-Type-Options "nosniff"

    # Защита от XSS в старых браузерах
    Header always set X-XSS-Protection "1; mode=block"

    # Referrer Policy
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # Скрыть версию сервера
    Header always unset X-Powered-By
    Header always unset Server
</IfModule>

# Скрыть подпись сервера
ServerSignature Off

# -------------------------------------------------------
# ЗАПРЕТ ДОСТУПА К СЛУЖЕБНЫМ ФАЙЛАМ
# -------------------------------------------------------
<FilesMatch "(\.env|composer\.json|composer\.lock|\.git)">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# Запрет листинга директорий
Options -Indexes
